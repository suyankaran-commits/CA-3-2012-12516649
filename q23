class Solution {
public:
    ListNode* mergeKLists(vector<ListNode*>& lists) {
        vector<int> v;
        for (auto p : lists)
            while (p) v.push_back(p->val), p=p->next;

        sort(v.begin(), v.end());

        ListNode dummy(0), *t = &dummy;
        for (int x : v) {
            t->next = new ListNode(x);
            t = t->next;
        }
        return dummy.next;
    }
};
